{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CNCRouter: build",
            "type": "shell",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\pio.exe",
            "args": ["run", "-e", "cncrouter"],
            "problemMatcher": []
        },
        {
            "label": "CNCRouter: upload and monitor",
            "type": "shell",
            "command": "${env:USERPROFILE}\\.platformio\\penv\\Scripts\\pio.exe",
            "args": ["run", "-e", "cncrouter", "-t", "upload", "-t", "monitor", "--upload-port", "${input:serialPort}"],
            "problemMatcher": []
        },
